# vim:set ft=dockerfile:

# Do not edit individual Dockerfiles manually. Instead, please make changes to the Dockerfile.template, which will be used by the build script to generate Dockerfiles.

# By policy, the base image tag should be a quarterly tag unless there's a
# specific reason to use a different one. This means January, April, July, or
# October.

# Cross-compiled linux-aarch64 build-tools (aapt2, aidl, zipalign,
# split-select). Google publishes none of these for linux-aarch64, so they
# have to be built from AOSP source -- see the PR description for the
# recipe. This image does not exist yet; it needs to be produced and
# published by CircleCI CI so the binaries carry CircleCI's provenance
# rather than a third party's. Until then this build cannot succeed, which
# is why this PR is a draft.
ARG ARM64_TOOLS_IMAGE=cimg/android-arm64-tools:latest
FROM ${ARM64_TOOLS_IMAGE} AS arm64tools

FROM cimg/%%PARENT%%:2026.08

ARG TARGETARCH

LABEL maintainer="CircleCI Execution Team <eng-execution@circleci.com>"

# Java 17 is default
RUN sudo apt-get update && sudo apt-get install -y \
		ant \
		openjdk-8-jdk \
		openjdk-17-jdk \
		openjdk-21-jdk \
		ruby-full \
	&& \
	sudo rm -rf /var/lib/apt/lists/* && \
	ruby -v && \
	sudo gem install bundler && \
	bundle version

#fixes issue with bundle install highlighted in https://github.com/CircleCI-Public/cimg-android/issues/82
RUN sudo chmod -R a+w /var/lib/gems/ /usr/local/bin

ENV M2_HOME=/usr/local/apache-maven
ENV MAVEN_OPTS=-Xmx2048m
ENV PATH=$M2_HOME/bin:$PATH
# Set JAVA_HOME (and related) environment variable. This will be set to our
# default Java version of 21 but the user would need to reset it when changing
# JAVA versions.
# Debian arch-suffixes these paths (-amd64 / -arm64); symlink to a stable
# name so JAVA_HOME is identical on both architectures.
RUN for v in 8 17 21; do \
		sudo ln -s "/usr/lib/jvm/java-${v}-openjdk-${TARGETARCH}" "/usr/lib/jvm/java-${v}-openjdk"; \
	done
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV JDK_HOME=${JAVA_HOME}
ENV JRE_HOME=${JDK_HOME}
ENV MAVEN_VERSION=3.9.16
ENV PATH=/opt/apache-maven/bin:$PATH
RUN dl_URL="https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" && \
	curl -sSL --fail --retry 3 $dl_URL -o apache-maven.tar.gz && \
	sudo tar -xzf apache-maven.tar.gz -C /opt/ && \
	rm apache-maven.tar.gz && \
	sudo ln -s /opt/apache-maven-* /opt/apache-maven && \
	mvn --version && \
	mkdir -p /home/circleci/.m2

ENV GRADLE_VERSION=9.6.1
ENV PATH=$PATH:/usr/local/gradle-${GRADLE_VERSION}/bin
RUN URL=https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip && \
	curl -sSL -o /tmp/gradle.zip $URL && \
	sudo unzip -d /usr/local /tmp/gradle.zip && \
	rm -rf /tmp/gradle.zip

# Install Android SDK Tools
ENV ANDROID_HOME="/home/circleci/android-sdk"
ENV ANDROID_SDK_ROOT=$ANDROID_HOME
ENV CMDLINE_TOOLS_ROOT="${ANDROID_HOME}/cmdline-tools/latest/bin"
ENV ADB_INSTALL_TIMEOUT=120
ENV PATH="${ANDROID_HOME}/emulator:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/tools:${ANDROID_HOME}/tools/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/platform-tools/bin:${PATH}"
# You can find the latest command line tools here: https://developer.android.com/studio#command-line-tools-only
RUN SDK_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip" && \
	mkdir -p ${ANDROID_HOME}/cmdline-tools && \
	mkdir ${ANDROID_HOME}/platforms && \
	mkdir ${ANDROID_HOME}/ndk && \
	wget -O /tmp/cmdline-tools.zip -t 5 "${SDK_TOOLS_URL}" && \
	unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
	rm /tmp/cmdline-tools.zip && \
	mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest

# The "tools" package depends on "emulator", which Google publishes for
# linux-x86_64 only; on arm64 sdkmanager warns and skips the dependency.
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "tools"; \
    fi && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platform-tools" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "build-tools;37.0.0" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "build-tools;36.1.0" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "build-tools;36.0.0" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "build-tools;35.0.0"
RUN echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-34" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-35" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-36" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-36.1" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-37.0" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-37.1" && \
    echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "platforms;android-37.2-beta1"

# --- arm64 native-binary fixups ------------------------------------------
# build-tools/platform-tools carry no host-arch constraint, so sdkmanager
# installs the x86-64 binaries on arm64 too, where none of them can exec.
COPY --from=arm64tools /out/ /tmp/arm64tools/
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
        set -eux; \
        for bt in ${ANDROID_HOME}/build-tools/*/; do \
            for f in aapt2 aidl zipalign split-select; do \
                sudo install -m0755 "/tmp/arm64tools/${f}" "${bt}${f}"; \
            done; \
        done; \
        sudo apt-get update && sudo apt-get install -y --no-install-recommends adb fastboot && \
        sudo rm -rf /var/lib/apt/lists/*; \
        sudo ln -sf "$(command -v adb)" "${ANDROID_HOME}/platform-tools/adb"; \
        sudo ln -sf "$(command -v fastboot)" "${ANDROID_HOME}/platform-tools/fastboot"; \
        mkdir -p /home/circleci/.gradle; \
        echo "android.aapt2FromMavenOverride=${ANDROID_HOME}/build-tools/36.1.0/aapt2" \
            >> /home/circleci/.gradle/gradle.properties; \
    fi; \
    sudo rm -rf /tmp/arm64tools

# Self-check: actually execute the toolchain. buildx builds arm64 layers
# under qemu, so an x86-64 binary in an arm64 rootfs fails here (exit 127)
# and breaks the build. This is the assertion #173 lacked -- CI proved the
# image built, never that it ran.
RUN set -eux; \
    aapt2 version; \
    zipalign 2>&1 | head -1; \
    adb --version; \
    java -version
# --------------------------------------------------------------------------

# Install some useful packages
RUN echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "extras;android;m2repository" && \
	echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "extras;google;m2repository" && \
	echo y | ${CMDLINE_TOOLS_ROOT}/sdkmanager "extras;google;google_play_services" && \
    sudo gem install fastlane --version 2.237.0 --no-document && \
	# firebase.tools serves a single x86-64 binary for linux and cimg/base
	# carries no npm, so the CLI is amd64-only here. On arm64, install it
	# yourself with `npm i -g firebase-tools` (the -node variant has npm).
	if [ "${TARGETARCH}" = "amd64" ]; then curl -sL https://firebase.tools | bash; fi

# Install Google Cloud CLI
# Latest gcloud version can be found here: https://cloud.google.com/sdk/docs/release-notes
ENV GCLOUD_VERSION=453.0.0-0
RUN curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo apt-key add - && \
	sudo add-apt-repository "deb https://packages.cloud.google.com/apt cloud-sdk main" && \
	sudo apt-get update && sudo apt-get install -y google-cloud-sdk=${GCLOUD_VERSION} && \
	sudo gcloud config set --installation component_manager/disable_update_check true && \
	sudo gcloud config set disable_usage_reporting false
